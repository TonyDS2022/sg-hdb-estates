# Secrets — the Mapbox token must never enter git history.
# config.js is generated by build_site.py from .mapbox_token or $MAPBOX_TOKEN.
.mapbox_token
site/config.js

# Local tooling
.pw/
shots/
__pycache__/
*.pyc
data/*.log

# Rebuilt in seconds by build_db.py from the sources + geocode cache below.
# site/data.json is also generated but IS committed — it is a deploy artifact.
data/hdb.sqlite
data/hdb_blocks.csv
data/hdb_blocks.json
data/hdb_estates.csv

# Re-downloaded by fetch_data.py and republished monthly — committing it would add a
# fresh ~23 MB blob to history on every scheduled refresh.
data/resale.csv
# Intermediate; build_resale.py regenerates it, and its content ships inside site/data.json.
data/resale_agg.json
